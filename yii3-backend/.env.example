APP_ENV=dev
APP_DEBUG=true
APP_HOST_PATH=
APP_URL=https://outline.local

DB_DRIVER=mysql
DB_HOST=MariaDB-11.8
DB_PORT=3306
DB_NAME=outline_yii3
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_TABLE_PREFIX=

REDIS_HOST=Redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

APP_SECRET=replace-with-at-least-64-random-characters
SESSION_COOKIE=outline_session
SESSION_TTL=2592000

FILE_STORAGE=local
FILE_STORAGE_LOCAL_ROOT_DIR=runtime/uploads
FILE_STORAGE_UPLOAD_MAX_SIZE=262144000

SMTP_DSN=smtp://127.0.0.1:25
SMTP_FROM_EMAIL=outline@outline.local

CORS_ALLOWED_ORIGINS=https://outline.local
TRUSTED_PROXIES=127.0.0.1,::1
