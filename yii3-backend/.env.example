APP_ENV=dev
APP_DEBUG=true
APP_HOST_PATH=
APP_URL=http://outline.local

DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=outline_yii3;charset=utf8mb4
DB_USER=outline
DB_PASSWORD=outline
DB_TABLE_PREFIX=

REDIS_DSN=tcp://127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DATABASE=0

APP_SECRET=replace-with-at-least-64-random-characters
SESSION_COOKIE=outline_session
SESSION_TTL=2592000

FILE_STORAGE=local
FILE_STORAGE_LOCAL_ROOT_DIR=runtime/uploads
FILE_STORAGE_UPLOAD_MAX_SIZE=262144000

SMTP_DSN=smtp://localhost:1025
SMTP_FROM_EMAIL=outline@example.local

CORS_ALLOWED_ORIGINS=http://outline.local,http://localhost:3000
TRUSTED_PROXIES=127.0.0.1,::1
